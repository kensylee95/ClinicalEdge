{
  "productName": "ClinicalEdge",
  "version": "1.0.0",
  "identifier": "com.clinicaledge.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ClinicalEdge — Sovereign Medical Intake Node",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/llama-server"
    ],
    "resources": {
      "binaries/ggml.dll": ".",
      "binaries/ggml-cpu-x64.dll": ".",
      "binaries/ggml-base.dll": ".",
      "binaries/llama.dll": ".",
      "models/ggml-tiny.en.bin": "models/ggml-tiny.en.bin"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preloadConnections": ["sqlite:clinical_records.db"]
    }
  }
}