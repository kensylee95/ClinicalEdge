{
  "productName": "Structra",
  "version": "1.0.0",
  "identifier": "com.Structra.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Structra — Unstructured input. Structured records. Zero cloud.",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/llama-server"
    ],
    "resources": {
      "binaries/ggml.dll": ".",
      "binaries/ggml-cpu-x64.dll": ".",
      "binaries/ggml-base.dll": ".",
      "binaries/llama.dll": ".",
      "models/ggml-tiny.en.bin": "models/ggml-tiny.en.bin",
      "../assets/model/my_clinical_model.gguf": "models/my_clinical_model.gguf",
      "models/onnx/encoder_model_quantized.onnx": "models/onnx/encoder_model_quantized.onnx",
      "models/onnx/decoder_model_quantized.onnx": "models/onnx/decoder_model_quantized.onnx",
      "models/tokenizer.json": "models/tokenizer.json",
      "models/onnx/onnxtr_db_mobilenet_v3_large.onnx": "models/onnx/onnxtr_db_mobilenet_v3_large.onnx"
    },
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "compression": "none"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preloadConnections": ["sqlite:clinical_records.db"]
    }
  }
}